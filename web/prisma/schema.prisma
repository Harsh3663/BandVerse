// BandVerse production PostgreSQL schema (Prisma)
// Soft delete: deletedAt IS NULL for active rows
// Audit: AuditLog append-only; entity version for optimistic concurrency
// Money: amountMinor (paise) + currency

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  active
  suspended
  pending_verification
  deleted
}

enum RoleName {
  guest
  user
  performer
  organizer
  venue_manager
  admin
  support
}

enum EventStatus {
  draft
  published
  closed
  cancelled
  archived
}

enum ApplicationStatus {
  submitted
  shortlisted
  accepted
  rejected
  completed
  cancelled
  withdrawn
}

enum BookingStatus {
  requested
  confirmed
  advance_pending
  advance_paid
  completed
  reviewed
  cancelled
  declined
}

enum PaymentStatus {
  not_started
  pending
  authorized
  paid
  failed
  refunded
}

enum PaymentKind {
  advance
  balance
  refund
}

enum VerificationStatus {
  unverified
  pending
  verified
  rejected
  expired
}

enum MediaKind {
  image
  video
  audio
  document
}

model User {
  id                 String     @id @default(cuid())
  email              String     @unique
  phone              String?    @unique
  passwordHash       String?
  displayName        String
  avatarUrl          String?
  status             UserStatus @default(pending_verification)
  emailVerifiedAt    DateTime?
  phoneVerifiedAt    DateTime?
  lastLoginAt        DateTime?
  mfaEnabled         Boolean    @default(false)
  mfaSecretEncrypted String?
  mfaEnabledAt       DateTime?
  version            Int        @default(1)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  deletedAt          DateTime?
  anonymizedAt       DateTime?

  roles         UserRole[]
  sessions      Session[]
  organizer     Organizer?
  performer     Performer?
  notifications Notification[]
  auditLogs     AuditLog[]     @relation("AuditActor")
  mfaBackupCodes MfaBackupCode[]
  trustedDevices TrustedDevice[]

  @@index([status, deletedAt])
  @@index([createdAt])
  @@index([mfaEnabled, deletedAt])
}

model Role {
  id          String   @id @default(cuid())
  name        RoleName @unique
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String @id @default(cuid())
  resource    String
  action      String
  description String

  roles RolePermission[]

  @@unique([resource, action])
}

model UserRole {
  userId String
  roleId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Session {
  id               String    @id @default(cuid())
  userId           String
  refreshTokenHash String
  userAgent        String?
  ipAddress        String?
  deviceLabel      String?
  trustedDeviceId  String?
  lastSeenAt       DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  trustedDevice    TrustedDevice? @relation(fields: [trustedDeviceId], references: [id])

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@index([trustedDeviceId])
}

model MfaBackupCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@unique([userId, codeHash])
}

model TrustedDevice {
  id           String    @id @default(cuid())
  userId       String
  fingerprint  String
  label        String?
  lastSeenAt   DateTime  @default(now())
  trustedAt    DateTime  @default(now())
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions     Session[]

  @@unique([userId, fingerprint])
  @@index([userId, revokedAt])
}

model Organizer {
  id               String    @id @default(cuid())
  userId           String    @unique
  displayName      String
  organizationName String?
  hostId           String    @unique
  primaryVenueId   String?
  verified         Boolean   @default(false)
  version          Int       @default(1)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  events   Event[]
  bookings Booking[] @relation("OrganizerBookings")

  @@index([verified, deletedAt])
}

model Performer {
  id          String    @id @default(cuid())
  userId      String    @unique
  handle      String    @unique
  kind        String
  displayName String
  headline    String
  biography   String
  city        String
  state       String
  verified    Boolean   @default(false)
  ratingAvg   Float     @default(0)
  ratingCount Int       @default(0)
  profileJson Json
  version     Int       @default(1)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  packages     Package[]
  applications Application[]
  bookings     Booking[]
  reviews      Review[]
  media        MediaAsset[]

  @@index([city, deletedAt])
  @@index([kind, verified, deletedAt])
  @@index([ratingAvg, ratingCount])
  @@index([handle])
  @@index([userId, deletedAt])
  @@index([displayName])
}

model Venue {
  id          String    @id @default(cuid())
  ownerUserId String
  handle      String    @unique
  name        String
  type        String
  city        String
  state       String
  verified    Boolean   @default(false)
  profileJson Json
  version     Int       @default(1)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  events Event[]

  @@index([city, type, deletedAt])
  @@index([ownerUserId, deletedAt])
}

model Event {
  id            String      @id @default(cuid())
  hostId        String
  organizerId   String?
  venueId       String?
  eventTypeId   String
  title         String
  description   String?
  startsAt      DateTime
  endsAt        DateTime
  city          String
  state         String
  budgetMaxPaise Int
  budgetMinPaise Int?
  status        EventStatus @default(draft)
  payloadJson   Json
  version       Int         @default(1)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  deletedAt     DateTime?

  organizer    Organizer?    @relation(fields: [organizerId], references: [id])
  venue        Venue?        @relation(fields: [venueId], references: [id])
  applications Application[]
  bookings     Booking[]

  @@index([hostId, status, deletedAt])
  @@index([startsAt, city])
  @@index([eventTypeId, status])
  @@index([venueId])
  @@index([status, startsAt, deletedAt])
  @@index([city, status, deletedAt])
}

model Application {
  id                String            @id @default(cuid())
  eventId           String
  performerId       String
  proposedPackageId String?
  quotedPaise       Int
  currency          String            @default("INR")
  message           String
  status            ApplicationStatus @default(submitted)
  version           Int               @default(1)
  submittedAt       DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  deletedAt         DateTime?

  event     Event     @relation(fields: [eventId], references: [id])
  performer Performer @relation(fields: [performerId], references: [id])
  booking   Booking?

  @@unique([eventId, performerId])
  @@index([performerId, status, deletedAt])
  @@index([eventId, status])
}

model Booking {
  id                 String        @id @default(cuid())
  eventId            String
  performerId        String
  hostId             String
  organizerId        String?
  applicationId      String?       @unique
  packageId          String?
  agreedPaise        Int
  currency           String        @default("INR")
  status             BookingStatus @default(requested)
  cancellationReason String?
  version            Int           @default(1)
  requestedAt        DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  deletedAt          DateTime?

  event       Event        @relation(fields: [eventId], references: [id])
  performer   Performer    @relation(fields: [performerId], references: [id])
  organizer   Organizer?   @relation("OrganizerBookings", fields: [organizerId], references: [id])
  application Application? @relation(fields: [applicationId], references: [id])
  payments    Payment[]
  contract    Contract?
  review      Review?

  @@index([hostId, status, deletedAt])
  @@index([performerId, status, deletedAt])
  @@index([eventId])
  @@index([status, updatedAt, deletedAt])
  @@index([hostId, updatedAt])
}

model Offer {
  id            String    @id @default(cuid())
  eventId       String
  organizerId   String
  performerId   String
  applicationId String?
  amountPaise   Int
  currency      String    @default("INR")
  packageId     String?
  message       String?
  status        String
  expiresAt     DateTime?
  version       Int       @default(1)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  @@index([eventId, status])
  @@index([performerId, status])
}

model Contract {
  id                   String    @id @default(cuid())
  bookingId            String    @unique
  organizerId          String
  performerId          String
  status               String
  termsMarkdown        String
  signedByOrganizerAt  DateTime?
  signedByPerformerAt  DateTime?
  documentMediaId      String?
  version              Int       @default(1)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deletedAt            DateTime?
  booking              Booking   @relation(fields: [bookingId], references: [id])

  @@index([organizerId, status])
  @@index([performerId, status])
}

model Payment {
  id                String        @id @default(cuid())
  bookingId         String
  kind              PaymentKind
  amountPaise       Int
  currency          String        @default("INR")
  status            PaymentStatus @default(not_started)
  provider          String
  providerReference String?
  dueAt             DateTime?
  paidAt            DateTime?
  settlementStatus  String        @default("unsettled")
  settledAt         DateTime?
  version           Int           @default(1)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  deletedAt         DateTime?
  booking           Booking       @relation(fields: [bookingId], references: [id])
  ledgerEntries     LedgerEntry[]

  @@index([bookingId, kind])
  @@index([status, dueAt])
  @@index([provider, providerReference])
  @@index([settlementStatus, settledAt])
}

model LedgerEntry {
  id          String   @id @default(cuid())
  paymentId   String?
  bookingId   String?
  entryType   String
  amountPaise Int
  currency    String   @default("INR")
  direction   String
  reference   String
  metadataJson Json?
  createdAt   DateTime @default(now())
  payment     Payment? @relation(fields: [paymentId], references: [id])

  @@unique([reference])
  @@index([paymentId, createdAt])
  @@index([bookingId, createdAt])
  @@index([entryType, createdAt])
}

model WebhookDelivery {
  id                String    @id @default(cuid())
  provider          String
  idempotencyKey    String    @unique
  eventType         String
  providerReference String?
  payloadJson       Json
  status            String    @default("received")
  attempts          Int       @default(0)
  lastError         String?
  processedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([provider, status, createdAt])
  @@index([status, attempts])
}

model Review {
  id              String    @id @default(cuid())
  bookingId       String    @unique
  performerId     String
  reviewerId      String
  rating          Int
  title           String?
  comment         String
  verifiedBooking Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?
  booking         Booking   @relation(fields: [bookingId], references: [id])
  performer       Performer @relation(fields: [performerId], references: [id])

  @@index([performerId, rating, deletedAt])
  @@index([reviewerId])
}

model MediaAsset {
  id             String    @id @default(cuid())
  ownerUserId    String
  performerId    String?
  kind           MediaKind
  url            String
  mimeType       String
  sizeBytes      Int
  checksumSha256 String?
  title          String
  alt            String?
  visibility     String    @default("public")
  scanStatus     String    @default("pending")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  performer      Performer? @relation(fields: [performerId], references: [id])

  @@index([ownerUserId, deletedAt])
  @@index([performerId, kind, deletedAt])
}

model Package {
  id          String    @id @default(cuid())
  performerId String
  name        String
  description String
  pricePaise  Int
  currency    String    @default("INR")
  durationMin Int
  inclusions  String[]
  negotiable  Boolean   @default(true)
  payloadJson Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  performer   Performer @relation(fields: [performerId], references: [id])

  @@index([performerId, deletedAt])
}

model AvailabilitySlot {
  id               String   @id @default(cuid())
  ownerType        String
  ownerId          String
  startsAt         DateTime
  endsAt           DateTime
  status           String
  relatedBookingId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([ownerType, ownerId, startsAt])
  @@index([relatedBookingId])
  @@index([status, startsAt])
}

model Conversation {
  id            String    @id @default(cuid())
  bookingId     String?
  applicationId String?
  updatedAt     DateTime  @updatedAt
  createdAt     DateTime  @default(now())
  messages      Message[]
  participants  ConversationParticipant[]

  @@index([bookingId])
  @@index([applicationId])
  @@index([updatedAt])
}

model ConversationParticipant {
  conversationId String
  userId         String
  role           String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  sentAt         DateTime @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, sentAt])
  @@index([senderId, sentAt])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  channel   String
  status    String
  title     String
  body      String
  href      String?
  readAt    DateTime?
  metaJson  Json?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, createdAt])
}

model Verification {
  id               String             @id @default(cuid())
  subjectType      String
  subjectId        String
  status           VerificationStatus @default(pending)
  documentMediaIds String[]
  reviewerUserId   String?
  notes            String?
  submittedAt      DateTime           @default(now())
  reviewedAt       DateTime?
  expiresAt        DateTime?

  @@index([subjectType, subjectId, status])
  @@index([status, submittedAt])
}

model RecommendationRun {
  id               String   @id @default(cuid())
  requesterUserId  String?
  eventContextHash String
  performerIds     String[]
  scoresJson       Json
  reasons          String[]
  createdAt        DateTime @default(now())

  @@index([requesterUserId, createdAt])
  @@index([eventContextHash])
}

model AnalyticsSnapshot {
  id          String   @id @default(cuid())
  subjectType String
  subjectId   String
  periodStart DateTime
  periodEnd   DateTime
  metricsJson Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([subjectType, subjectId, periodStart, periodEnd])
  @@index([subjectType, subjectId])
}

model Activity {
  id          String   @id @default(cuid())
  actorUserId String
  verb        String
  objectType  String
  objectId    String
  summary     String
  createdAt   DateTime @default(now())

  @@index([actorUserId, createdAt])
  @@index([objectType, objectId, createdAt])
}

model AuditLog {
  id             String   @id @default(cuid())
  actorUserId    String?
  action         String
  resource       String
  resourceId     String?
  ipAddress      String?
  userAgent      String?
  correlationId  String?
  beforeJson     Json?
  afterJson      Json?
  metadataJson   Json?
  immutableHash  String?
  createdAt      DateTime @default(now())
  actor          User?    @relation("AuditActor", fields: [actorUserId], references: [id])

  @@index([resource, resourceId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@index([correlationId, createdAt])
}

/// Booking lifecycle projection (enterprise workflow). In-memory service is primary in mock mode.
model BookingLifecycle {
  id                String   @id @default(cuid())
  eventId           String
  performerId       String
  hostId            String
  applicationId     String?
  bookingId         String?
  status            String
  agreedPaise       Int?
  currency          String   @default("INR")
  advancePaymentId  String?
  balancePaymentId  String?
  refundPaymentId   String?
  contractId        String?
  version           Int      @default(1)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  timeline          BookingTimelineEvent[]

  @@index([hostId, status])
  @@index([performerId, status])
  @@index([eventId, status])
  @@index([bookingId])
}

model BookingTimelineEvent {
  id           String   @id @default(cuid())
  lifecycleId  String
  actorUserId  String?
  action       String
  fromStatus   String?
  toStatus     String?
  metadataJson Json?
  createdAt    DateTime @default(now())
  lifecycle    BookingLifecycle @relation(fields: [lifecycleId], references: [id], onDelete: Cascade)

  @@index([lifecycleId, createdAt])
  @@index([actorUserId, createdAt])
}

/// Performer portfolio media (in-memory service is primary in mock mode).
model PortfolioMedia {
  id          String   @id @default(cuid())
  performerId String
  title       String
  description String   @default("")
  mediaType   String
  thumbnail   String?
  url         String
  duration    Int?
  featured    Boolean  @default(false)
  hero        Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([performerId, mediaType])
  @@index([performerId, createdAt])
}

model PerformerSetlist {
  id          String   @id @default(cuid())
  performerId String
  title       String
  songs       String[]
  duration    Int
  eventType   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([performerId, eventType])
}

model VerifiedPerformance {
  id                 String   @id @default(cuid())
  eventId            String
  organizerId        String
  performerId        String
  verificationStatus String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([eventId, performerId])
  @@index([performerId, verificationStatus])
  @@index([organizerId])
}

model PortfolioAnalyticsEvent {
  id          String   @id @default(cuid())
  performerId String
  event       String
  mediaId     String?
  createdAt   DateTime @default(now())

  @@index([performerId, event, createdAt])
}

/// Internal messaging conversation (memory service primary in mock mode).
model MessagingConversation {
  id          String   @id @default(cuid())
  organizerId String
  performerId String
  bookingId   String?
  eventId     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  messages    MessagingMessage[]
  offers      NegotiationOffer[]

  @@index([organizerId, updatedAt])
  @@index([performerId, updatedAt])
  @@index([bookingId])
  @@index([eventId])
}

model MessagingMessage {
  id             String    @id @default(cuid())
  conversationId String
  senderId       String
  messageType    String
  content        String    @default("")
  attachmentUrl  String?
  sentAt         DateTime  @default(now())
  editedAt       DateTime?
  deletedAt      DateTime?
  conversation   MessagingConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  receipts       MessageReceipt[]

  @@index([conversationId, sentAt])
  @@index([senderId, sentAt])
}

model NegotiationOffer {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  amountPaise    Int
  currency       String   @default("INR")
  notes          String   @default("")
  status         String
  parentOfferId  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  conversation   MessagingConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId, status])
}

model MessageReceipt {
  id            String   @id @default(cuid())
  messageId     String
  participantId String
  status        String
  updatedAt     DateTime @updatedAt
  message       MessagingMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, participantId])
  @@index([participantId, status])
}
